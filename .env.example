# Copy this file to .env and fill in the two tokens.
#   node --env-file=.env mirror.mjs

# GitHub personal access token (classic) with scopes: repo, read:org
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitLab personal access token with scopes: api, write_repository
GL_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Where to put the target projects on GitLab.
# Empty = the token owner's personal namespace.
# Can be a group, including a nested group: "backups/github"
GL_NAMESPACE=

# Optional
# GH_HOST=github.com
# GL_HOST=gitlab.com
# MIRROR_DIR=.mirrors          # local cache of bare clones (speeds up later runs)
# CONCURRENCY=3                # repos mirrored in parallel
# INCLUDE_FORKS=false
# INCLUDE_ARCHIVED=true
# GL_VISIBILITY=mirror        # mirror = same as GitHub (public->public, private->private)
#                              # or force: private | public | internal
# ONLY_MATCH=^myuser/          # regex on "owner/repo" - useful for a first test run
# GL_UNPROTECT=true            # drop GitLab branch protection so force-push works
# DRY_RUN=1                    # show the plan only, change nothing
